<Window x:Class="Lab6_Resources.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Lab6_Resources.ViewModels"
        Title="💙 Калькулятор" Height="580" Width="340" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Window.DataContext>
        <vm:CalculatorViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- МЕНЮ -->
        <Menu Grid.Row="0" Background="#FFD700" FontSize="14">
            <MenuItem Header="🎨 Темы" FontSize="14">
                <MenuItem Header="💖 Glamour" Click="GlamourTheme_Click"/>
                <MenuItem Header="👧 Для девочек" Click="GirlsTheme_Click"/>
                <MenuItem Header="👦 Для мальчиков" Click="BoysTheme_Click"/>
                <MenuItem Header="🤓 Для чайников" Click="DummyTheme_Click"/>
            </MenuItem>
            <MenuItem Header="🔊 Звуки" FontSize="14">
                <MenuItem Header="Включить" IsCheckable="True" IsChecked="True"/>
                <MenuItem Header="Выключить" IsCheckable="True"/>
            </MenuItem>
            <MenuItem Header="ℹ️ О программе" Click="About_Click" FontSize="14"/>
        </Menu>

        <!-- КАЛЬКУЛЯТОР С СЕРЫМ ФОНОМ ПО УМОЛЧАНИЮ -->
        <Border x:Name="CalculatorBorder" Grid.Row="1" CornerRadius="20" BorderThickness="2">
            <Border.Background>
                <SolidColorBrush Color="#2C2C2C"/>
            </Border.Background>
            <Border.BorderBrush>
                <SolidColorBrush Color="#4A9FD8"/>
            </Border.BorderBrush>

            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="120"/>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="60"/>
                </Grid.RowDefinitions>

                <!-- Display -->
                <Grid Grid.Row="0" Margin="10">
                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding OperationIndicator}" 
                                   Foreground="#87CEEB" FontSize="24" 
                                   HorizontalAlignment="Right" Margin="0,0,0,5"/>
                        <TextBlock Text="🩵 Calculator" 
                                   Foreground="#00B4D8" FontSize="9" 
                                   HorizontalAlignment="Right" Margin="0,0,0,3"
                                   FontStyle="Italic" Opacity="0.9"/>
                        <TextBlock Text="{Binding DisplayText}" 
                                   Foreground="White" FontSize="64" 
                                   FontWeight="Light" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>

                <!-- Row 1: AC, +/-, %, / -->
                <Grid Grid.Row="1" Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="AC" Command="{Binding ClearCommand}"
                            Background="{DynamicResource SecondaryBrush}" Foreground="White" 
                            FontSize="20" FontWeight="Bold" Margin="3" BorderThickness="0" Cursor="Hand"/>
                    <Button Grid.Column="1" Content="±" Command="{Binding ToggleSignCommand}"
                            Background="{DynamicResource SecondaryBrush}" Foreground="White" 
                            FontSize="20" FontWeight="Bold" Margin="3" BorderThickness="0" Cursor="Hand"/>
                    <Button Grid.Column="2" Content="%" Command="{Binding PercentageCommand}"
                            Background="{DynamicResource SecondaryBrush}" Foreground="White" 
                            FontSize="20" FontWeight="Bold" Margin="3" BorderThickness="0" Cursor="Hand"/>
                    <Button Grid.Column="3" Content="÷" Command="{Binding DivideCommand}"
                            Background="{DynamicResource PrimaryBrush}" Foreground="White" 
                            FontSize="20" FontWeight="Bold" Margin="3" BorderThickness="0" Cursor="Hand"/>
                </Grid>

                <!-- Row 2: 7, 8, 9, × -->
                <Grid Grid.Row="2" Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="7" Command="{Binding Input7Command}"
                            Background="{DynamicResource PrimaryBrush}" Foreground="White" 
                            FontSize="20" FontWeight="Bold" Margin="3" BorderThickness="0" Cursor="Hand"/>
                    <Button Grid.Column="1" Content="8" Command="{Binding Input8Command}"
                            Background="{DynamicResource PrimaryBrush}" Foreground="White" 
                            FontSize="20" FontWeight="Bold" Margin="3" BorderThickness="0" Cursor="Hand"/>
                    <Button Grid.Column="2" Content="9" Command="{Binding Input9Command}"
                            Background="{DynamicResource PrimaryBrush}" Foreground="White" 
                            FontSize="20" FontWeight="Bold" Margin="3" BorderThickness="0" Cursor="Hand"/>
                    <Button Grid.Column="3" Content="×" Command="{Binding MultiplyCommand}"
                            Background="{DynamicResource PrimaryBrush}" Foreground="White" 
                            FontSize="20" FontWeight="Bold" Margin="3" BorderThickness="0" Cursor="Hand"/>
                </Grid>

                <!-- Row 3: 4, 5, 6, - -->
                <Grid Grid.Row="3" Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="4" Command="{Binding Input4Command}"
                            Background="{DynamicResource PrimaryBrush}" Foreground="White" 
                            FontSize="20" FontWeight="Bold" Margin="3" BorderThickness="0" Cursor="Hand"/>
                    <Button Grid.Column="1" Content="5" Command="{Binding Input5Command}"
                            Background="{DynamicResource PrimaryBrush}" Foreground="White" 
                            FontSize="20" FontWeight="Bold" Margin="3" BorderThickness="0" Cursor="Hand"/>
                    <Button Grid.Column="2" Content="6" Command="{Binding Input6Command}"
                            Background="{DynamicResource PrimaryBrush}" Foreground="White" 
                            FontSize="20" FontWeight="Bold" Margin="3" BorderThickness="0" Cursor="Hand"/>
                    <Button Grid.Column="3" Content="−" Command="{Binding SubtractCommand}"
                            Background="{DynamicResource PrimaryBrush}" Foreground="White" 
                            FontSize="20" FontWeight="Bold" Margin="3" BorderThickness="0" Cursor="Hand"/>
                </Grid>

                <!-- Row 4: 1, 2, 3, + -->
                <Grid Grid.Row="4" Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="1" Command="{Binding Input1Command}"
                            Background="{DynamicResource PrimaryBrush}" Foreground="White" 
                            FontSize="20" FontWeight="Bold" Margin="3" BorderThickness="0" Cursor="Hand"/>
                    <Button Grid.Column="1" Content="2" Command="{Binding Input2Command}"
                            Background="{DynamicResource PrimaryBrush}" Foreground="White" 
                            FontSize="20" FontWeight="Bold" Margin="3" BorderThickness="0" Cursor="Hand"/>
                    <Button Grid.Column="2" Content="3" Command="{Binding Input3Command}"
                            Background="{DynamicResource PrimaryBrush}" Foreground="White" 
                            FontSize="20" FontWeight="Bold" Margin="3" BorderThickness="0" Cursor="Hand"/>
                    <Button Grid.Column="3" Content="+" Command="{Binding AddCommand}"
                            Background="{DynamicResource PrimaryBrush}" Foreground="White" 
                            FontSize="20" FontWeight="Bold" Margin="3" BorderThickness="0" Cursor="Hand"/>
                </Grid>

                <!-- Row 5: 0 (wide), ., = -->
                <Grid Grid.Row="5" Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="0" Command="{Binding Input0Command}"
                            Background="{DynamicResource PrimaryBrush}" Foreground="White" 
                            FontSize="20" FontWeight="Bold" Margin="3" BorderThickness="0" Cursor="Hand"
                            HorizontalContentAlignment="Left" Padding="25,0,0,0"/>
                    <Button Grid.Column="1" Content="." Command="{Binding DecimalCommand}"
                            Background="{DynamicResource PrimaryBrush}" Foreground="White" 
                            FontSize="20" FontWeight="Bold" Margin="3" BorderThickness="0" Cursor="Hand"/>
                    <Button Grid.Column="2" Content="=" Command="{Binding EqualsCommand}"
                            Background="{DynamicResource PrimaryBrush}" Foreground="White" 
                            FontSize="20" FontWeight="Bold" Margin="3" BorderThickness="0" Cursor="Hand"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>