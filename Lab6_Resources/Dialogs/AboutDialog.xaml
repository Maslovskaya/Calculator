<Window x:Class="Lab6_Resources.Dialogs.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="О программе" Height="400" Width="350"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid Background="#FFD700">
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="🧮" FontSize="60" 
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <StackPanel Grid.Row="1" Margin="20">
            <TextBlock Text="КАЛЬКУЛЯТОР С РЕСУРСАМИ" 
                       FontSize="16" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,10"/>
            <TextBlock Text="Лабораторная работа №6" 
                       FontSize="14" HorizontalAlignment="Center" Margin="0,10"/>
            <Line X1="0" Y1="0" X2="200" Y2="0" Stroke="Black" Margin="0,15"/>
            <TextBlock Text="Студент: [Ваше ФИО]" FontSize="12" Margin="0,10"/>
            <TextBlock Text="Группа: [Ваша группа]" FontSize="12" Margin="0,5"/>
        </StackPanel>

        <Button Grid.Row="2" Content="OK" Width="100" Height="35"
                Click="OK_Click" Background="#4A9FD8" Foreground="White"
                FontSize="14" FontWeight="Bold" Cursor="Hand"/>
    </Grid>
</Window>